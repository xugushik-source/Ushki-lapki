# Used to build absolute URLs for canonical tags, hreflang alternates,
# sitemap.xml and JSON-LD. Set this to the real production domain.
NEXT_PUBLIC_SITE_URL=https://example-clinic.com

# Analytics — leave any of these unset to disable that integration.
# Scripts only load after a visitor accepts the cookie banner (see
# src/components/analytics/AnalyticsScripts.tsx).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
