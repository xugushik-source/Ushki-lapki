# Used to build absolute URLs for canonical tags, hreflang alternates,
# sitemap.xml and JSON-LD. Set this to the real production domain — for a
# GitHub Pages project deployment that means the full pages.dev-style URL
# including the repo path, e.g. https://<owner>.github.io/<repo>.
NEXT_PUBLIC_SITE_URL=https://example-clinic.com

# GitHub Pages serves a project repo from /<repo>/, not the domain root —
# every asset and internal link needs that prefix or they 404. Leave unset
# for local dev and for a custom-domain or <owner>.github.io root deploy.
# .github/workflows/deploy-pages.yml sets this automatically at build time;
# it only needs setting by hand for a manual `npm run build`.
NEXT_PUBLIC_BASE_PATH=

# Analytics — leave any of these unset to disable that integration.
# Scripts only load after a visitor accepts the cookie banner (see
# src/components/analytics/AnalyticsScripts.tsx).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
